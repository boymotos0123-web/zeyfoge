{
  "name": "ZeyForge — CAD 3D de hardware",
  "short_name": "ZeyForge",
  "description": "CAD 3D profissional de hardware: placas, flats, conectores, render fotorrealista e BOM.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e1115",
